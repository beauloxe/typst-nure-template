#!/bin/sh
# Keeps template/mise pinned to the commit being pushed to main.
# A commit can't pin itself, so when the pin is stale this adds a pin commit
# on top and stops the push: run `git push` again. Skip with --no-verify.
# Enable once: git config core.hooksPath .githooks

cfg=template/mise/.mise/config.toml
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && continue

  pinned=$(git show "$local_sha:$cfg" 2>/dev/null | sed -n 's/^nure_package_rev *= *"\(.*\)"/\1/p')

  # Up to date: the pinned commit is an ancestor and only $cfg changed since.
  if [ -n "$pinned" ] \
    && git merge-base --is-ancestor "$pinned" "$local_sha" 2>/dev/null \
    && git diff --quiet "$pinned" "$local_sha" -- . ":!$cfg"; then
    continue
  fi

  short=$(git rev-parse --short "$local_sha")
  # The pin commit goes onto the checked-out branch, so it must be the pushed one.
  if [ "$(git symbolic-ref -q HEAD)" != "$local_ref" ] || [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push: $cfg is not pinned to $short; check out ${local_ref#refs/heads/} and push again" >&2
    exit 1
  fi
  if ! git diff --quiet HEAD -- "$cfg"; then
    echo "pre-push: $cfg has local changes; commit or stash them and push again" >&2
    exit 1
  fi

  sed "s/^nure_package_rev *= *\".*\"/nure_package_rev = \"$local_sha\"/" "$cfg" > "$cfg.tmp" \
    && mv "$cfg.tmp" "$cfg" || exit 1
  git commit --no-verify -q -m "template(mise): pin package to $short" -- "$cfg" || exit 1
  echo "pre-push: pinned template/mise to $short; run git push again" >&2
  exit 1
done

exit 0
